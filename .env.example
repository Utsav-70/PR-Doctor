# Copy to .env and fill in. .env is git-ignored; .env.example is committed.
# Every key below is read via settings.py — nothing reads os.environ directly.

# --- core -----------------------------------------------------------------------
PRGUARD_ENV=development
LOG_LEVEL=INFO

# --- GitHub App (required) ------------------------------------------------------
# From the App's settings page. The private key is downloaded once at creation —
# GitHub will not show it again.
GITHUB_APP_ID=
# PEM contents on a single line, newlines written as \n
GITHUB_APP_PRIVATE_KEY=
# The random secret you set on the App's webhook configuration
GITHUB_WEBHOOK_SECRET=

# --- LLM ------------------------------------------------------------------------
# LLM_PROVIDER selects which SDK answers review_diff(). LLM_MODEL must match it —
# settings.py refuses to boot on a claude/gemini mismatch.
LLM_PROVIDER=anthropic
# Optional: the Anthropic SDK also resolves an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Required only when LLM_PROVIDER=gemini. No local-profile fallback exists.
GEMINI_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high

# --- datastores -----------------------------------------------------------------
# compose overrides these with service hostnames for the api/worker containers.
# The values below are for running the app on the *host* against the compose
# datastores, so they must match the published HOST ports below — not 5432/6379,
# which are the ports inside the containers.
DATABASE_URL=postgresql+psycopg://prguard:prguard@localhost:5433/prguard
REDIS_URL=redis://localhost:6380/0
REDIS_RESULT_URL=redis://localhost:6380/1

# --- budgets --------------------------------------------------------------------
MAX_CHANGED_LINES=3000
MAX_CHANGED_FILES=50
